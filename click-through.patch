diff --git a/SESSION_NOTES.md b/SESSION_NOTES.md
new file mode 100644
index 0000000..beeef14
--- /dev/null
+++ b/SESSION_NOTES.md
@@ -0,0 +1,58 @@
+# Сессия: click-through (overlay) режим для PNGTuber-Remix 1.4.x
+
+## Задача
+Режим, в котором окно остаётся поверх всех окон, без рамок и с прозрачным фоном, а мышь
+«проходит» сквозь него в другие приложения (как overlay в PureRef). Горячая клавиша для
+выхода из режима должна настраиваться в настройках.
+
+## Что уже было в проекте
+- `Scripts/AutoLoads/Settings.gd`: `toggle_borders()` (Alt+Enter) и `set_always_on_top()`.
+  Оба состояния сохраняются в `theme_settings` и восстанавливаются при запуске.
+- Прозрачность включена в `project.godot` (`per_pixel_transparency`, `size/transparent`).
+- Фон «Transparent» и режим Preview скрывают интерфейс редактора.
+- `GlobInput` (GDExtension, libuiohook) ловит клавиши вне фокуса. В этой сборке у него есть
+  `is_action_just_pressed(имя)`, `is_key_pressed`, `start_hook`, `stop_hook`, свойство `backend`.
+- `toggle_borders` обрабатывается через `Input` в `_input`, то есть работает только при фокусе.
+  Для выхода из click-through он не годится.
+
+## Что сделано
+| Файл | Изменение |
+|---|---|
+| `Scripts/AutoLoads/overlay_mode.gd` (новый) | Автозагрузка `OverlayMode`: флаг `Window.FLAG_MOUSE_PASSTHROUGH`, глобальный хоткей через `GlobInput`, иконка в трее (`StatusIndicator`), хранение хоткея в `theme_settings["click_through_hotkey"]` |
+| `Scripts/UI/TopPanel/Components/click_through_hotkey_row.gd` (новый) | Строка настроек: показ, переназначение и сброс хоткея |
+| `project.godot` | Автозагрузка `OverlayMode` |
+| `UI/EditorUI/TopUI/Components/Settings_popup.tscn` | Строка «Click-through Hotkey» на вкладке Remix |
+| `UI/EditorUI/TopUI/top_ui.tscn`, `Scripts/UI/TopPanel/TopBarInput.gd` | Пункт «Click-through» в меню Window редактора |
+| `UI/StreamUI/StreamTopUI.tscn`, `Scripts/UI/StreamUI/s_top_ui_scripts.gd` | Тот же пункт в меню стрим-режима |
+| `Localization/translations.csv` | Строки `TR_CLICK_THROUGH*` (en, ru) |
+
+## Ключевые решения
+- Хоткей по умолчанию: Ctrl+Alt+F10. Настраивается в Settings > Remix. Без модификатора
+  принимаются только F-клавиши и другие «специальные» клавиши, чтобы буква не включала режим при наборе текста.
+- Состояние click-through **не сохраняется**: приложение всегда стартует с обычной мышью.
+- Режим не включится, если нет ни одного пути выхода: нужен либо рабочий `GlobInput`
+  (`backend != "dummy"`), либо иконка в трее.
+- Реальное состояние окна читается обратно через `get_flag`, а не предполагается.
+- Во время переназначения хоткея глобальный опрос приостанавливается (`OverlayMode.capturing`).
+- `Settings.gd` не менялся. Хоткей пишется в тот же файл настроек через `Settings.save()`.
+
+## Как проверено
+- Godot 4.7.2 headless: проект запускается, ошибок скриптов в новых файлах нет.
+- Тест логики (24 проверки): хоткей по умолчанию, переназначение, сохранение в настройки,
+  отказ от голой буквы, Escape, сброс, закрытие окна во время ввода, наличие пункта меню в обоих UI.
+- **Не проверено** (нужен ваш запуск на Windows): сам click-through, глобальный хоткей вне
+  фокуса, иконка в трее, комбинация с always on top и без рамок.
+
+## Что проверить руками
+1. Preview-режим + фон Transparent + Always on top + Toggle borders, затем «Click-through» в меню Window.
+2. Клики идут в приложения под окном, хоткей и клик по иконке в трее возвращают мышь.
+3. Settings > Remix > Click-through Hotkey: смена комбинации работает сразу и сохраняется после перезапуска.
+4. После изменения `translations.csv` откройте проект в редакторе Godot, чтобы он переимпортировал переводы.
+
+## Замечания и риски
+- На Linux/Wayland глобальный ввод и passthrough ненадёжны, режим там может не включиться.
+- Если флаг `FLAG_MOUSE_PASSTHROUGH` на вашей системе не сработает, запасной вариант:
+  `Window.mouse_passthrough_polygon` с маленьким полигоном вне видимой области.
+- Возможная связь со старым багом «прозрачная рамка»: `toggle_borders()` после смены флага
+  ставит размер из `theme_settings.screen_size`, а он обновляется только при «Save window positions».
+  Не доказано и в этой сессии не менялось.
diff --git a/Scripts/AutoLoads/overlay_mode.gd b/Scripts/AutoLoads/overlay_mode.gd
new file mode 100644
index 0000000..3b2110a
--- /dev/null
+++ b/Scripts/AutoLoads/overlay_mode.gd
@@ -0,0 +1,140 @@
+extends Node
+## Click-through ("overlay") mode for the main window.
+##
+## While enabled, every mouse click goes to whatever is below the window.
+## The window itself can no longer be clicked, so there are always two ways out:
+##   1. a global hotkey (works while the window is not focused, via GlobInput),
+##   2. a click on the system tray icon.
+## The state is intentionally NOT saved: the app always starts with a normal mouse.
+
+signal click_through_changed(enabled: bool)
+
+const ACTION := "toggle_click_through"
+const SETTINGS_KEY := "click_through_hotkey"
+const DEFAULT_HOTKEY := {
+	"keycode": KEY_F10,
+	"ctrl": true,
+	"alt": true,
+	"shift": false,
+	"meta": false,
+}
+
+var enabled: bool = false
+## Set by the hotkey settings button while it waits for a key, so that the
+## currently bound hotkey does not toggle the mode in the middle of rebinding.
+var capturing: bool = false
+
+var _tray: StatusIndicator = null
+var _tray_available: bool = false
+
+
+func _ready() -> void:
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	# Default binding right away, the saved one is applied once Settings has loaded.
+	apply_hotkey()
+	_setup_tray()
+	# Settings.gd waits 0.1 s before it reads the settings file.
+	await get_tree().create_timer(0.3).timeout
+	apply_hotkey()
+
+
+func _process(_delta: float) -> void:
+	if capturing:
+		return
+	if GlobInput.is_action_just_pressed(ACTION):
+		toggle()
+
+
+# --- Click-through ---------------------------------------------------------
+
+func toggle() -> void:
+	set_click_through(not enabled)
+
+
+## Returns true if the window ended up in the requested state.
+func set_click_through(on: bool) -> bool:
+	if on and not has_exit_path():
+		push_warning("OverlayMode: click-through refused, neither the global hotkey nor the tray icon is available.")
+		return false
+
+	var window := get_window()
+	window.set_flag(Window.FLAG_MOUSE_PASSTHROUGH, on)
+	# Read the real state back instead of assuming that the flag was applied.
+	var actual: bool = window.get_flag(Window.FLAG_MOUSE_PASSTHROUGH)
+	if actual != enabled:
+		enabled = actual
+		_update_tray()
+		click_through_changed.emit(enabled)
+	return actual == on
+
+
+## Click-through is only allowed when the user has a way back.
+func has_exit_path() -> bool:
+	var hotkey_ok := str(GlobInput.backend) != "dummy"
+	return _tray_available or hotkey_ok
+
+
+# --- Hotkey ------------------------------------------------------------------
+
+func get_hotkey() -> Dictionary:
+	var saved: Variant = Settings.theme_settings.get(SETTINGS_KEY)
+	if saved is Dictionary and int(saved.get("keycode", 0)) != 0:
+		return saved
+	return DEFAULT_HOTKEY.duplicate()
+
+
+func set_hotkey(hotkey: Dictionary) -> void:
+	Settings.theme_settings[SETTINGS_KEY] = hotkey
+	Settings.save()
+	apply_hotkey()
+
+
+func reset_hotkey() -> void:
+	set_hotkey(DEFAULT_HOTKEY.duplicate())
+
+
+func hotkey_to_event(hotkey: Dictionary) -> InputEventKey:
+	var event := InputEventKey.new()
+	event.keycode = int(hotkey.get("keycode", KEY_F10)) as Key
+	event.ctrl_pressed = bool(hotkey.get("ctrl", false))
+	event.alt_pressed = bool(hotkey.get("alt", false))
+	event.shift_pressed = bool(hotkey.get("shift", false))
+	event.meta_pressed = bool(hotkey.get("meta", false))
+	return event
+
+
+func hotkey_text(hotkey: Dictionary = get_hotkey()) -> String:
+	return OS.get_keycode_string(hotkey_to_event(hotkey).get_keycode_with_modifiers())
+
+
+## Puts the stored hotkey into the InputMap, where GlobInput looks for it.
+func apply_hotkey() -> void:
+	if InputMap.has_action(ACTION):
+		InputMap.action_erase_events(ACTION)
+	else:
+		InputMap.add_action(ACTION)
+	InputMap.action_add_event(ACTION, hotkey_to_event(get_hotkey()))
+
+
+# --- Tray icon ---------------------------------------------------------------
+
+func _setup_tray() -> void:
+	if not DisplayServer.has_feature(DisplayServer.FEATURE_STATUS_INDICATOR):
+		return
+	_tray = StatusIndicator.new()
+	_tray.icon = load("res://PicklesSurprised.png")
+	_tray.pressed.connect(_on_tray_pressed)
+	add_child(_tray)
+	_tray_available = true
+	_update_tray()
+
+
+func _on_tray_pressed(_mouse_button: int, _mouse_position: Vector2i) -> void:
+	toggle()
+
+
+func _update_tray() -> void:
+	if _tray == null:
+		return
+	var state := "ON" if enabled else "OFF"
+	_tray.tooltip = "PNGTube-Remix | %s: %s" % [tr("TR_CLICK_THROUGH"), state]
