#!/usr/bin/env python
# Builds the ClickThrough GDExtension. See README_BUILD.md.
#
#   scons platform=windows arch=x86_64 target=template_release use_mingw=yes \
#         build_profile=build_profile.json
#
# godot-cpp is expected next to this folder (../godot-cpp) or at $GODOT_CPP.
import os

godot_cpp = os.environ.get("GODOT_CPP", "../godot-cpp")
env = SConscript(os.path.join(godot_cpp, "SConstruct"))

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "../../addons/click_through/bin/click_through{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
env.NoCache(library)
Default(library)
